    public static final Map<String, String> FACILITY_TOKEN_TO_CAMPUS = new Map<String, String>{
        'mumbai' => 'Mumbai',
        'dubai' => 'Dubai',
        'singapore' => 'Singapore'
    };

    public static Boolean requiresPunchOut(String campus) {
        if(String.isBlank(campus)) return true;
        if(PUNCH_OUT_REQUIRED_BY_CAMPUS.containsKey(campus)) return PUNCH_OUT_REQUIRED_BY_CAMPUS.get(campus);
        return true;
    }
    public static Boolean requiresPunchIn(String campus) {
        if(String.isBlank(campus)) return true;
        if(PUNCH_IN_REQUIRED_BY_CAMPUS.containsKey(campus)) return PUNCH_IN_REQUIRED_BY_CAMPUS.get(campus);
        return true;
    }

    public static String campusFromFacilityName(String facilityName) {
        if(String.isBlank(facilityName)) return CAMPUS_UNKNOWN;
        String low = facilityName.toLowerCase();
        for(String token : FACILITY_TOKEN_TO_CAMPUS.keySet()) {
            if(low.contains(token)) return FACILITY_TOKEN_TO_CAMPUS.get(token);
        }
        return CAMPUS_UNKNOWN;
    }
    
