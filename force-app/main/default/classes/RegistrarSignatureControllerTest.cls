@IsTest
private class RegistrarSignatureControllerTest {

    // 1x1 transparent PNG
    private static final String PNG_BASE64 =
        'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==';
    // JPEG header only - enough for type sniffing and decoding
    private static final String JPEG_BASE64 = '/9j/4AAQSkZJRgABAQAAAQABAAD/2w==';

    private static User buildUser(Boolean withPermission) {
        Profile p = [SELECT Id FROM Profile WHERE Name = 'Standard User' LIMIT 1];
        String key = String.valueOf(Crypto.getRandomInteger()).replace('-', '');
        User u = new User(
            Alias = 'rsig' + key.left(4),
            Email = 'rsig' + key + '@example.com',
            EmailEncodingKey = 'UTF-8',
            LastName = 'Registrar Test',
            LanguageLocaleKey = 'en_US',
            LocaleSidKey = 'en_IN',
            ProfileId = p.Id,
            TimeZoneSidKey = 'Asia/Kolkata',
            UserName = 'rsig' + key + '@example.com.dsutest'
        );
        insert u;
        if (withPermission) {
            PermissionSet ps = [SELECT Id FROM PermissionSet WHERE Name = 'ID_Card_Settings_Admin' LIMIT 1];
            insert new PermissionSetAssignment(AssigneeId = u.Id, PermissionSetId = ps.Id);
        }
        return u;
    }

    @IsTest
    static void testUploadReplaceRemove() {
        User admin = buildUser(true);
        System.runAs(admin) {
            RegistrarSignatureController.SignatureInfo info = RegistrarSignatureController.getRegistrarSignature();
            System.assertEquals(true, info.canManage, 'Permission set grants manage access.');
            System.assertEquals(false, info.hasSignature, 'Nothing uploaded yet.');

            info = RegistrarSignatureController.saveRegistrarSignature('registrar.png', PNG_BASE64);
            System.assertEquals(true, info.hasSignature, 'Signature should be stored.');
            System.assertEquals('registrar.png', info.fileName);
            System.assertEquals('data:image/png;base64,' + PNG_BASE64, info.dataUrl);
            System.assert(RegistrarSignatureController.getSignatureUrl().contains('/servlet/servlet.FileDownload?file='),
                'Card URL should point at the Document.');

            info = RegistrarSignatureController.saveRegistrarSignature('registrar.jpg', JPEG_BASE64);
            System.assertEquals('data:image/jpeg;base64,' + JPEG_BASE64, info.dataUrl, 'Upload replaces the old one.');
            System.assertEquals(1, [SELECT COUNT() FROM Document WHERE DeveloperName = 'Registrar_Signature'],
                'Only one signature Document is kept.');

            info = RegistrarSignatureController.removeRegistrarSignature();
            System.assertEquals(false, info.hasSignature, 'Signature should be cleared.');
            System.assertEquals(null, RegistrarSignatureController.getSignatureUrl());
            System.assertEquals(0, [SELECT COUNT() FROM Document WHERE DeveloperName = 'Registrar_Signature']);
        }
    }

    @IsTest
    static void testCardReadsSignatureForAnyUser() {
        User admin = buildUser(true);
        System.runAs(admin) {
            RegistrarSignatureController.saveRegistrarSignature('registrar.png', PNG_BASE64);
        }
        // The ID card is generated by other users / the batch; they must see the same signature.
        User other = buildUser(false);
        System.runAs(other) {
            System.assertNotEquals(null, RegistrarSignatureController.getSignatureUrl(),
                'Signature must be readable by users who did not upload it.');
            System.assertEquals(false, RegistrarSignatureController.getRegistrarSignature().canManage);
        }
    }

    @IsTest
    static void testNoPermissionCannotChange() {
        User other = buildUser(false);
        System.runAs(other) {
            assertThrows(new SaveCall(PNG_BASE64), 'Users without the permission cannot upload.');
            assertThrows(new RemoveCall(), 'Users without the permission cannot remove.');
        }
    }

    @IsTest
    static void testRejectsBadFiles() {
        User admin = buildUser(true);
        System.runAs(admin) {
            assertThrows(new SaveCall(''), 'Empty upload is rejected.');
            assertThrows(new SaveCall(EncodingUtil.base64Encode(Blob.valueOf('not an image'))), 'Non-image is rejected.');
            String tooBig = EncodingUtil.base64Encode(EncodingUtil.convertFromHex(
                '89504E470D0A1A0A' + '00'.repeat(RegistrarSignatureController.MAX_BYTES + 10)));
            assertThrows(new SaveCall(tooBig), 'Oversized image is rejected.');
        }
    }

    private interface Call { void run(); }
    private class SaveCall implements Call {
        String data;
        SaveCall(String data) { this.data = data; }
        public void run() { RegistrarSignatureController.saveRegistrarSignature('x.png', data); }
    }
    private class RemoveCall implements Call {
        public void run() { RegistrarSignatureController.removeRegistrarSignature(); }
    }

    private static void assertThrows(Call c, String message) {
        try {
            c.run();
            System.assert(false, message);
        } catch (AuraHandledException e) {
            System.assert(true);
        }
    }
}