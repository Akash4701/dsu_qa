@RestResource(urlMapping='/TermsHistory/*')
global class RestApi_GetTermsByContact {
	
    @HttpGet
    global static void doGet(){
        RestResponse res = RestContext.response;
        res.addHeader('Content-Type', 'application/json');
        String contactId = RestContext.request.params.get('contactId');
        system.debug('contactId-->'+contactId);
        
        try{
            if(String.isNotBlank(contactId) && contactId!=null &&((contactId.length()==15)||(contactId.length()==18))){
                List<hed__Program_Enrollment__c> prgEnrollList = [Select Id,Name,hed__Contact__c,hed__Contact__r.Name,hed__Affiliation__c,hed__Affiliation__r.hed__Status__c,Term__c,Term__r.Name,Term__r.Term_Status__c from hed__Program_Enrollment__c where hed__Contact__c=:contactId];
                List<reqWrapper> wrapList = new List<reqWrapper>();
                for(hed__Program_Enrollment__c prgEnrlObj:prgEnrollList){
                    reqWrapper wrapObj = new reqWrapper();
                    wrapObj.contactId=prgEnrlObj.hed__Contact__c;
                    wrapObj.contactName=prgEnrlObj.hed__Contact__r.Name;
                    wrapObj.termId=prgEnrlObj.Term__c;
                    wrapObj.termName=prgEnrlObj.Term__r.Name;
                    wrapObj.termStatus=prgEnrlObj.Term__r.Term_Status__c;
                    wrapObj.status=prgEnrlObj.hed__Affiliation__r.hed__Status__c;
                    wrapList.add(wrapObj);
                }
                if(!wrapList.isEmpty()){
                    res.statusCode=200;
                    res.responseBody=Blob.valueOf('{ "success": "true" ,"data":'+json.serialize(wrapList)+'}');
                }else{
                    res.statusCode = 200;
                    res.responseBody = Blob.valueOf('{ "success": "true" ,"data": [] }');
                }
                
            }else{
                res.statusCode=400;
                res.responseBody=Blob.valueOf('{ "success": "false" ,"message": "Invalid Parameters"}');
            }
            
        }catch(Exception e){
            res.statusCode = 400;
            res.responseBody = Blob.valueOf( '{ "success": "false" , "message": "bad request", "errors": "'+e.getMessage()+'at Line Number'+e.getLineNumber()+'" }' );
        }
    }
    
    global class reqWrapper{
        public Id contactId;
        public string contactName;
        public Id termId;
        public string termName;
        public string termStatus;
        public string status;
    }
