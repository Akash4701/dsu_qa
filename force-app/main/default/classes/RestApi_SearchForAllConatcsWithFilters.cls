@RestResource(urlMapping='/users/*')
global class RestApi_SearchForAllConatcsWithFilters {
    
    @HttpGet
    global static void doGet(){
        RestResponse res = RestContext.response;
        res.addHeader('Content-Type', 'application/json');
        String name = RestContext.request.params.get('name');
        String department = RestContext.request.params.get('department');
        String acaProgram = RestContext.request.params.get('acaProgram');
        String term = RestContext.request.params.get('term');
        String prgPlan = RestContext.request.params.get('programPlan');
        String pageNumber = RestContext.request.params.get('pageNo');
        String count = RestContext.request.params.get('count');
        String recordType = RestContext.request.params.get('type');
        String country = RestContext.request.params.get('country');
        system.debug('The req Name'+name);
        String contactquery;
        String prgEnrollQuery;
        String ttlQuery;
        List<jsonWrapper> responseList = new List<jsonWrapper>();
        List<contactWrapper> jsonWrapperConList = new List<contactWrapper>();
        List<contactWrapper> jsonWrapperAffList = new List<contactWrapper>();
        ttlQuery = 'Select Id,Name,Phone,Email,Birthdate,Registration_Number__c,hed__Gender__c,Status__c,RecordType.Name from contact where name!=null';
        if(String.isNotBlank(recordType)){
            ttlQuery += ' and RecordType.Name =\''+recordType+'\'';
        }
        if(String.isNotBlank(country)){
            ttlQuery += ' and hed__Country_of_Origin__c =\''+country+'\'';
        }
        List<Contact> contactList = Database.query(ttlQuery);
        try{
            if(String.isBlank(department) && String.isBlank(acaProgram) && String.isBlank(term) && String.isBlank(prgPlan)){
                contactquery = 'Select Id,Name,Phone,Email,Birthdate,Registration_Number__c,hed__Gender__c,Status__c,RecordType.Name from contact where Name!=null';
                if(String.isNotBlank(name)){
                    contactquery += ' and Name LIKE \'%' + name + '%\'';  
                }
                if(String.isNotBlank(recordType)){
                    contactquery += ' and RecordType.Name =\''+recordType+'\'';
                }
                if(String.isNotBlank(country)){
                    contactquery += ' and hed__Country_of_Origin__c =\''+country+'\'';
                }
                contactList = Database.query(contactquery);
                if(String.isNotBlank(count)){
                    contactquery += ' order by Name asc limit '+count;  
                }else{
                    contactquery += ' order by Name asc limit 25';
                }
                
                if(String.isNotBlank(pageNumber) && String.isNotBlank(count)){
                    pageNumber = String.valueOf(integer.valueOf(pageNumber)*integer.valueOf(count));
                    system.debug('The pagenumber'+pageNumber);
                    contactquery += ' offset '+pageNumber;
                }else if(String.isNotBlank(pageNumber) && String.isBlank(count)){
                    pageNumber = String.valueOf(integer.valueOf(pageNumber)*25);
                    system.debug('The pagenumber'+pageNumber);
                    contactquery += ' offset '+pageNumber;
                }
                system.debug('@@conQuery'+contactquery);
                for(Contact con:Database.query(contactquery)){
                    contactWrapper wrapObj = new contactWrapper();
                    
                    wrapObj.contactId = con.Id;
                    wrapObj.contactName = con.Name;
                    wrapObj.phone = con.Phone;
                    wrapObj.email = con.Email;
                    wrapObj.status = con.Status__c;
                    wrapObj.recordType = con.RecordType.Name;
                    wrapObj.birthdate = con.Birthdate;
                    wrapObj.regNumber = con.Registration_Number__c;
                    wrapObj.gender = con.hed__Gender__c;
                    jsonWrapperConList.add(wrapObj);
                }
            }else if(String.isNotBlank(department) || String.isNotBlank(acaProgram) || String.isNotBlank(term) || String.isNotBlank(prgPlan)){
                prgEnrollQuery = 'Select Id,hed__Account__c,hed__Contact__c,hed__Contact__r.Name,hed__Contact__r.Phone, hed__Contact__r.Email, hed__Contact__r.hed__Gender__c, hed__Contact__r.Status__c, hed__Contact__r.Birthdate, hed__Contact__r.Registration_Number__c, hed__Contact__r.RecordType.Name, hed__Contact__r.hed__Country_of_Origin__c, Term__c,hed__Program_Plan__c from hed__Program_Enrollment__c where hed__Contact__c!=null';
                if(String.isNotBlank(department)){
                    prgEnrollQuery += ' and hed__Account__r.ParentId =\''+department+'\'';
                }
                if(String.isNotBlank(acaProgram)){
                    prgEnrollQuery += ' and hed__Account__c =\''+acaProgram+'\'';
                }
                if(String.isNotBlank(name)){
                    prgEnrollQuery += ' and hed__Contact__r.Name LIKE \'%' + name + '%\'';
                }
                if(String.isNotBlank(recordType)){
                    prgEnrollQuery += ' and hed__Contact__r.RecordType.Name =\''+recordType+'\'';
                }
                if(String.isNotBlank(country)){
                    prgEnrollQuery += ' and hed__Contact__r.hed__Country_of_Origin__c =\''+country+'\'';
                }
                if(String.isNotBlank(term)){
                    prgEnrollQuery += ' and Term__c =\''+term+'\'';
                }
                if(String.isNotBlank(prgPlan)){
                    prgEnrollQuery += ' and hed__Program_Plan__c =\''+prgPlan+'\'';
                }
                if(String.isNotBlank(count)){ 
                    prgEnrollQuery += ' order by hed__Contact__r.Name asc limit '+count;
                }else{
                    prgEnrollQuery += ' order by hed__Contact__r.Name asc limit 25';
                }
                
                if(String.isNotBlank(pageNumber) && String.isNotBlank(count)){
                    pageNumber = String.valueOf(integer.valueOf(pageNumber)*integer.valueOf(count));
                    system.debug('The pagenumber'+pageNumber);
                    prgEnrollQuery += ' offset '+pageNumber;
                }else if(String.isNotBlank(pageNumber) && String.isBlank(count)){
                    pageNumber = String.valueOf(integer.valueOf(pageNumber)*25);
                    system.debug('The pagenumber'+pageNumber);
                    prgEnrollQuery += ' offset '+pageNumber;
                }
                system.debug('@@'+prgEnrollQuery);
                for(hed__Program_Enrollment__c affObj:Database.query(prgEnrollQuery)){
                    contactWrapper wrapObj = new contactWrapper();
                    
                    wrapObj.contactId = affObj.hed__Contact__c;
                    wrapObj.contactName = affObj.hed__Contact__r.Name;
                    wrapObj.phone = affObj.hed__Contact__r.Phone;
                    wrapObj.email = affObj.hed__Contact__r.Email;
                    wrapObj.status = affObj.hed__Contact__r.Status__c;
                    wrapObj.recordType = affObj.hed__Contact__r.RecordType.Name;
                    wrapObj.birthdate = affObj.hed__Contact__r.Birthdate;
                    wrapObj.regNumber = affObj.hed__Contact__r.Registration_Number__c;
                    wrapObj.gender = affObj.hed__Contact__r.hed__Gender__c;
                    jsonWrapperAffList.add(wrapObj);
                }
            }
            jsonWrapper jsonWrapObj = new jsonWrapper();
            jsonWrapObj.totalNoOfUsers = contactList.size();
            if(!jsonWrapperConList.isEmpty()){
                jsonWrapObj.contactsList = jsonWrapperConList;
                //responseList.addAll(jsonWrapperConList);
            }else if(!jsonWrapperAffList.isEmpty()){
                jsonWrapObj.contactsList = jsonWrapperAffList;
                //responseList.addAll(jsonWrapperAffList);
            }
            res.statusCode = 200;
            res.responseBody=Blob.valueOf('{ "success": "true" ,"data":'+json.serialize(jsonWrapObj)+'}');
        }Catch(Exception e){
            res.statusCode = 400;
            res.responseBody = Blob.valueof('{"success" : false","message" : "'+e.getMessage()+' at line number '+e.getLineNumber()+'"}');
        }  
    }
    
    global class jsonWrapper{
        public Integer totalNoOfUsers;
        public List<contactWrapper> contactsList; 
    }
    global class contactWrapper{
        public Id contactId;
        public string contactName;
        public string phone;
        public string email;
        public string status;
        public string recordType;
        public date birthdate;
        public string regNumber;
        public string gender;
    }
