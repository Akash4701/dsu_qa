@RestResource(urlMapping='/MasterSubjectsWithTermData/*')
global class RestApi_GetMasterSubjectsWithTerm {
    @HttpGet
    global static void doGetActivityData(){
        RestResponse res = RestContext.response;
        res.addHeader('Content-Type', 'application/json');
        string jsonResponse;
        Map<String,List<Object>> app=new Map<String,List<Object>>();
        Map<Id,List<hed__Plan_Requirement__c>> mapOfTermsListWithActivity = new Map<Id,List<hed__Plan_Requirement__c>>();
        String academicProgramId=RestContext.request.params.get('academicProgramId');
        String termNumber=RestContext.request.params.get('termNumber');
        //String intake=RestContext.request.params.get('intake');
        //String year=RestContext.request.params.get('year');
        //academicProgramId = '0011y00000P7qGHAAZ';
        if(String.isNotEmpty(academicProgramId)){
            string termRefNumber;
            if(String.isNotBlank(termNumber) && termNumber!=null){
                //termRefNumber = termNumber.toLowerCase().capitalize();
                termRefNumber='Term '+termNumber;
            }
            system.debug('termNumber'+termRefNumber);
            System.debug('in if '+academicProgramId);
            Map<Id, hed__Term__c> mapOfTerms = new Map<Id, hed__Term__c>([select id, name from hed__Term__c where RecordType.DeveloperName = 'Master_Record' and hed__Account__c = :academicProgramId and Term_Reference__c=:termRefNumber/*AND Program_Plan__r.Batch__c = :year AND  Program_Plan__r.Intake__c = :intake*/ order by Name ASC] );
            System.debug('in if '+mapOfTerms.keySet());
            if(!mapOfTerms.keySet().isEmpty()){
                for( hed__Plan_Requirement__c plan : [Select id,name, Institute__r.Name,RecordType.Name, hed__Plan_Requirement__r.Name,Term__c, 
                    (select id, name, hed__Course__c,hed__Course__r.Name, hed__Course__r.hed__Course_ID__c, hed__Course__r.Credits__c,hed__Course__r.hed__Credit_Hours__c,hed__Course__r.Offset__c,Co_Requisites_1__r.Name,Co_Requisites_2__r.Name,Co_Requisites_3__r.Name,Pre_Requisites_1__r.Name,Pre_Requisites_2__r.Name,Pre_Requisites_3__r.Name,Offset__c,hed__Category__c,Exam_Required__c,Number_of_Sessions__c 
                        FROM hed__Plan_Requirements__r where RecordType.Name = 'Master Unit') 
                    FROM hed__Plan_Requirement__c 
                    WHERE Term__c IN :mapOfTerms.keySet() AND RecordType.Name = 'Master Group'] )

                {
                        system.debug('plan'+plan);                                    
                    if(!mapOfTermsListWithActivity.containsKey(plan.Term__c)){
                        mapOfTermsListWithActivity.put(plan.Term__c,new List<hed__Plan_Requirement__c>());
                    }   
                    mapOfTermsListWithActivity.get(plan.Term__c).add(plan);                                         
                }
                System.debug('in if '+mapOfTermsListWithActivity.size());
                List<TermDataWrapper> termDataWrapperList = new List<TermDataWrapper>();
                for(hed__Term__c term :mapOfTerms.values()){
                    TermDataWrapper termWrapper = new TermDataWrapper();
                    termWrapper.termId = term.Id;
                    termWrapper.termName = term.Name;
                    if(mapOfTermsListWithActivity.containsKey(term.Id)){
                        List<SpecializationWrapper> specialWrappersList=new List<SpecializationWrapper>();
                        for(hed__Plan_Requirement__c plan: mapOfTermsListWithActivity.get(term.Id))
                        {
                            System.debug('in if '+plan);
                            SpecializationWrapper responseData=new SpecializationWrapper();
                            responseData.specializationName=plan.Institute__r.Name;
                            
                            List<CourseWrapper> courseWrappersList = new List<CourseWrapper> ();
                            for(hed__Plan_Requirement__c childPlan :plan.hed__Plan_Requirements__r){
                                CourseWrapper course = new CourseWrapper();
                                course.masterPlanReqId = childPlan.Id;
                                course.id = childPlan.hed__Course__c;
                                course.courseName = childPlan.hed__Course__r.Name;
                                course.courseId = childPlan.hed__Course__r.hed__Course_ID__c;
                                course.credit = childPlan.hed__Course__r.Credits__c;
                                course.creditHours = childPlan.hed__Course__r.hed__Credit_Hours__c;
                                course.offset = childPlan.Offset__c;
                                course.category = childPlan.hed__Category__c;
                                course.examRequired = childPlan.Exam_Required__c;
                                course.numberOfSessions=childPlan.Number_of_Sessions__c;
                                List<String> preList = new List<String>();
                                List<String> coList = new List<String>();
                                if(childPlan.Pre_Requisites_1__r.Name != null)
                                	preList.add(childPlan.Pre_Requisites_1__r.Name);
                                if(childPlan.Pre_Requisites_2__r.Name != null)
                                	preList.add(childPlan.Pre_Requisites_2__r.Name);
                                if(childPlan.Pre_Requisites_3__r.Name != null)
                                	preList.add(childPlan.Pre_Requisites_3__r.Name);
                                if(childPlan.Co_Requisites_1__r.Name != null)
                                	coList.add(childPlan.Co_Requisites_1__r.Name);
                                if(childPlan.Co_Requisites_2__r.Name != null)
                                	coList.add(childPlan.Co_Requisites_2__r.Name);
                                if(childPlan.Co_Requisites_3__r.Name != null)
                                	coList.add(childPlan.Co_Requisites_3__r.Name);
                                List<activitesWrapper> actWrapList = new List<activitesWrapper>();
                                for(Activity__c actObj:[Select Id,Name,Activity_type__c,Course__r.Name,Week_No__c,Offset__c,Duration__c,Activity_Duration__c from Activity__c where Course__c=:childPlan.hed__Course__c and RecordType.Name='Master Record']){
                                    activitesWrapper actWrapObj = new activitesWrapper();
                                    actWrapObj.activityId = actObj.Id;
                                    actWrapObj.activityName = actObj.Name;
                                    actWrapObj.activityType = actObj.Activity_type__c;
                                    actWrapObj.subject = actObj.Course__r.Name;
                                    actWrapObj.offset = actObj.Offset__c;
                                    actWrapObj.duration = actObj.Activity_Duration__c;
                                    actWrapObj.weekNo = actObj.Week_No__c;
                                    actWrapList.add(actWrapObj);
                                }
                                course.PreRequisites = preList;
                                course.CoRequisites = coList;
                                course.activitesList = actWrapList;
                                courseWrappersList.add(course);
                            }
                            responseData.courseList = courseWrappersList;
                            specialWrappersList.add(responseData);
                        }
                        termWrapper.specialWrapperList = specialWrappersList;
                        termDataWrapperList.add(termWrapper);
                    }
                }
                System.debug('termDataWrapperList '+termDataWrapperList);
                jsonResponse = JSON.serialize(termDataWrapperList);
                System.debug('jsonResponse '+jsonResponse);
                if(jsonResponse!=null){    
                    res.responseBody=Blob.valueOf(jsonResponse); 
                }
                else
                {
                    res.responseBody=Blob.valueOf('[]'); 
                } 

            }
            else{
                res.responseBody = Blob.valueOf( '{ "success": "true" , "message": "No Data Found"}' );
            }
        }
        else{
            res.responseBody = Blob.valueOf( '{ "success": "true" , "message": "No Data Found"}' );
        }      
    }
    
    public class TermDataWrapper{
        public Id termId{get;set;}
        public String termName{get;set;}
        public List<SpecializationWrapper> specialWrapperList {get;set;}
    }
    
    public class SpecializationWrapper{
        public String specializationName{get;set;}
        public List<CourseWrapper> courseList {get;set;}
    }
    
    public class CourseWrapper {
        public Id masterPlanReqId {get;set;}
        public string id {get;set;}
        public string courseName {get;set;}
        public string courseId {get;set;}
        public Double credit {get;set;}
        public Double creditHours {get;set;}
        public Double offset {get;set;}
        public string category {get;set;}
        public boolean examRequired {get;set;}
        public Decimal numberOfSessions {get;set;}
        public List<String> PreRequisites;
        public List<String> CoRequisites;
        public List<activitesWrapper> activitesList;
    }
    public class activitesWrapper{
        public string activityId;
        public string activityName;
        public string activityType;
        public string subject;
        public Double offset;
        public Double duration;
        public Decimal weekNo;
    }  
