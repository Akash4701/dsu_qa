<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Parent_PlanReq_must_belong_to_Prog_Plan</fullName>
    <active>false</active>
    <description>Parent Plan Requirement must belong to the same Program Plan.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(hed__Plan_Requirement__c)), hed__Plan_Requirement__r.hed__Program_Plan__c !=  hed__Program_Plan__c)</errorConditionFormula>
    <errorDisplayField>hed__Plan_Requirement__c</errorDisplayField>
    <errorMessage>Parent Plan Requirement must belong to the same Program Plan.</errorMessage>
</ValidationRule>
