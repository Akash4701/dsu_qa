<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Portal_Login_URL__c</fullName>
    <description>Student portal login URL for the current org, read from the Email Branding custom setting. Exists so email templates can merge the environment-specific link.</description>
    <externalId>false</externalId>
    <formula>BLANKVALUE($Setup.Email_Branding__c.Portal_Login_URL__c, &quot;https://student.dsuonline.com&quot;)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Portal Login URL</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
