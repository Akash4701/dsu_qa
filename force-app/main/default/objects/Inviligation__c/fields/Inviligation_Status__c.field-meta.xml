  AND(
    NOT(ISBLANK( Number_Of_Anwer_Sheet_Collected__c )),
    NOT(ISBLANK( Number_Of_Student_Appear__c ))
  ),
  &quot;Completed&quot;,
  &quot;Pending&quot;
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Inviligation Status</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
