<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Case_Re_Opened</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status, &quot;Re-opened&quot;),
    NOT(ISPICKVAL(PRIORVALUE(Status), &quot;Resolved&quot;))
)</errorConditionFormula>
    <errorMessage>You can only change the Case Status to &apos;Re-opened&apos; if the previous status was &apos;Resolved&apos;.</errorMessage>
</ValidationRule>
