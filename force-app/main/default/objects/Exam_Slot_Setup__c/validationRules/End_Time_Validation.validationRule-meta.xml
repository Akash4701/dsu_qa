<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>End_Time_Validation</fullName>
    <active>false</active>
    <errorConditionFormula>End_Time__c &lt;=  Start_Time__c</errorConditionFormula>
    <errorDisplayField>End_Time__c</errorDisplayField>
    <errorMessage>End Time must not be before (or equal to) Start Date/Time</errorMessage>
</ValidationRule>
