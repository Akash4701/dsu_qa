<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Start_date_validation</fullName>
    <active>true</active>
    <errorConditionFormula>Start_Date__c &lt; Today()</errorConditionFormula>
    <errorDisplayField>Start_Date__c</errorDisplayField>
    <errorMessage>Start Date/Time must not be in the past</errorMessage>
</ValidationRule>
