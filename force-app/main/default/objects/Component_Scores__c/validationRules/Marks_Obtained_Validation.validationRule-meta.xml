<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Marks_Obtained_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>IF( RecordType.Name = &apos;Component Score&apos;, Marks_Obtained__c &gt;  Component_Name__r.Maximum_Marks_for_the_Component__c ,  Sub_Component_Marks_Obtained__c &gt; Course_Evaluation_Subcomponent__r.Maximum_Marks_for_the_Sub_Component__c )</errorConditionFormula>
    <errorMessage>Marks Obtained cannot be greater than the evaluation component maximum marks</errorMessage>
</ValidationRule>
