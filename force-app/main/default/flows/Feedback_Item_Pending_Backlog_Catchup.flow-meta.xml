    <environments>Default</environments>
    <formulas>
        <name>Backlog_Remainder_Email_DateTime</name>
        <dataType>DateTime</dataType>
        <expression>IF(
  {!Loop_Pending_Feedback_Items.Start_Date__c} &gt; {!Loop_Pending_Feedback_Items.End_Date__c},
  NULL,
  DATETIMEVALUE({!Loop_Pending_Feedback_Items.Start_Date__c})
  +
  CASE(
    TRIM(BLANKVALUE({!Loop_Pending_Feedback_Items.Course_Offering__r.Campus__r.Name}, &quot;Mumbai&quot;)),
    &quot;Mumbai&quot;, (21 - 5.5) / 24,
    &quot;Singapore&quot;, (23.5 - 5.5) / 24,
    &quot;Sydney&quot;, (14.5 - 5.5) / 24,
    &quot;Dubai&quot;, (19.5 - 5.5) / 24,
    (21 - 5.5) / 24
  )
)</expression>
    </formulas>
    <formulas>
