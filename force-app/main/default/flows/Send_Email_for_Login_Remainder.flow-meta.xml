    <formulas>
        <name>Days_Since_Last_Login</name>
        <dataType>Number</dataType>
        <expression>TODAY() - {!$Record.Last_Portal_Login_Date__c}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>Should_Send_Reminder_Formula</name>
        <dataType>Boolean</dataType>
        <expression>MOD({!Days_Since_Last_Login} - 15, 7) = 0 &amp;&amp; {!Days_Since_Last_Login} &gt;= 15</expression>
    </formulas>
    <formulas>
        <name>Today_less_than_15</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 15</expression>
    </formulas>
