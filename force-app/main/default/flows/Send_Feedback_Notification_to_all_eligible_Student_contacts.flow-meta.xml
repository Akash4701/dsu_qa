    <formulas>
        <name>Send_Email_formula</name>
        <dataType>DateTime</dataType>
        <expression>IF(
  /* Stop if past End Date */
  CASE(
    BLANKVALUE({!$Record.Notification_Counter__c}, 0),
    0, {!$Record.Start_Date__c},
    1,  {!$Record.Start_Date__c}+ 1,
     {!$Record.Start_Date__c} + ((BLANKVALUE({!$Record.Notification_Counter__c}, 0) - 1) * 2)
  ) &gt; {!$Record.End_Date__c},
  NULL,
  
  /* Calculate Target DateTime in UTC */
  DATETIMEVALUE(
    CASE(
      BLANKVALUE({!$Record.Notification_Counter__c}, 0),
      0, {!$Record.Start_Date__c},
      1, {!$Record.Start_Date__c} + 1,
      {!$Record.Start_Date__c} + ((BLANKVALUE({!$Record.Notification_Counter__c}, 0) - 1) * 2)
    )
  )
  +
  /* IST Time to UTC Conversion: (IST Hour - 5.5) / 24 */
  CASE(
    IF(BLANKVALUE({!$Record.Notification_Counter__c}, 0) = 1, &quot;Morning&quot;, &quot;Evening&quot;),
    
    &quot;Evening&quot;,
    CASE(
      TRIM(BLANKVALUE({!$Record.Course_Offering__r.Campus__r.Name}, &quot;Mumbai&quot;)),
      &quot;Mumbai&quot;, (21 - 5.5) / 24,
      &quot;Singapore&quot;, (23.5 - 5.5) / 24,
      &quot;Sydney&quot;, (14.5 - 5.5) / 24,
      &quot;Dubai&quot;, (19.5 - 5.5) / 24,
      (21 - 5.5) / 24
    ),
    
    &quot;Morning&quot;,
    CASE(
      TRIM(BLANKVALUE({!$Record.Course_Offering__r.Campus__r.Name}, &quot;Mumbai&quot;)),
      &quot;Mumbai&quot;, (9 - 5.5) / 24,
      &quot;Singapore&quot;, (11.5 - 5.5) / 24,
      &quot;Sydney&quot;, (2.5 - 5.5) / 24,
      &quot;Dubai&quot;, (7.5 - 5.5) / 24,
      (9 - 5.5) / 24
    ),
    0
  )
)</expression>
    </formulas>
