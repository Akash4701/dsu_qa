<?xml version="1.0" encoding="UTF-8"?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>AwsSv4</authenticationProtocol>
    <description>Signs Amazon SES requests (AWS Signature V4, region ap-south-1, service ses). The AWS Access Key ID and Secret Access Key are entered in Setup on principal SES_Principal and are never stored in source control.</description>
    <externalCredentialParameters>
        <parameterGroup>DefaultGroup</parameterGroup>
        <parameterName>AwsRegion</parameterName>
        <parameterType>AuthParameter</parameterType>
        <parameterValue>ap-south-1</parameterValue>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterGroup>DefaultGroup</parameterGroup>
        <parameterName>AwsService</parameterName>
        <parameterType>AuthParameter</parameterType>
        <parameterValue>ses</parameterValue>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterGroup>SES_Principal</parameterGroup>
        <parameterName>SES_Principal</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <label>AWS SES Credential</label>
</ExternalCredential>
