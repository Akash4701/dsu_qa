<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F4F6F9; padding:40px 16px;">
 <tbody>
  <tr>
   <td align="center">
    <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; width:100%;">
     <!-- ── HEADER ── -->
     <tbody>
      <tr>
       <td style="background-color:#FFFFFF; border-radius:16px 16px 0 0; padding:24px 36px; border-bottom:3px solid %%PRIMARY_COLOR%%;">
        <table width="100%" cellpadding="0" cellspacing="0" border="0">
         <tbody>
          <tr>
           <td valign="middle"><img src="{[devName:DSU_logo]}" alt="Dayananda Sagar University" style="max-width:260px; height:auto; display:block;" /></td>
           <td valign="middle" align="right">
            <div style="font-family:Arial,Helvetica,sans-serif; font-size:10px; color:%%PRIMARY_COLOR%%; letter-spacing:0.8px; text-transform:uppercase; font-weight:600;">Program Office · Feedback</div>
           </td>
          </tr>
         </tbody>
        </table>
       </td>
      </tr>
      <!-- ── HERO BAND ── -->
      <tr>
       <td style="background:linear-gradient(135deg,%%GRADIENT_START%% 0%,%%GRADIENT_END%% 100%); padding:30px 36px;">
        <table width="100%" cellpadding="0" cellspacing="0" border="0">
         <tbody>
          <tr>
           <td width="52" valign="middle" style="font-size:36px; padding-right:16px;">⏳</td>
           <td valign="middle">
            <p style="font-family:Georgia,'Times New Roman',serif; font-size:22px; color:#FFFFFF; margin:0 0 5px 0;">Feedback Submission Window Extended</p>
            <p style="font-family:Arial,Helvetica,sans-serif; font-size:13px; color:#C5DCFF; margin:0;">The deadline for your feedback has been moved on the DSU Student Portal.</p>
           </td>
          </tr>
         </tbody>
        </table>
       </td>
      </tr>
      <!-- ── BODY CARD ── -->
      <tr>
       <td style="background-color:#FFFFFF; padding:40px 36px 36px;">
        <p style="font-family:Georgia,'Times New Roman',serif; font-size:20px; color:%%DEEP_NAVY%%; margin:0 0 14px 0;">Dear All,</p>
        <p style="font-family:Arial,Helvetica,sans-serif; font-size:14px; line-height:1.8; color:#444455; margin:0 0 28px 0;">This is to notify you that the submission window for the <strong>%%FEEDBACK_TYPE%%</strong> feedback link for the following course offering has been <strong>extended</strong> on the DSU Student Portal:</p>
        <div style="font-family:Arial,Helvetica,sans-serif; font-size:10px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:%%PRIMARY_COLOR%%; margin-bottom:12px;">Extension Details</div>
        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:28px; border:1px solid #CCDDF5; border-radius:10px; overflow:hidden;">
         <tbody>
          <tr>
           <td width="55%" style="background-color:#EEF4FF; padding:14px 18px; font-family:Arial,Helvetica,sans-serif; font-size:13px; color:#4466AA; font-weight:600; border-bottom:1px solid #CCDDF5;">Course Offering</td>
           <td style="background-color:#EEF4FF; padding:14px 18px; font-family:Arial,Helvetica,sans-serif; font-size:13px; color:%%DEEP_NAVY%%; font-weight:700; border-bottom:1px solid #CCDDF5;">%%COURSE_OFFERING_NAME%%</td>
          </tr>
          <tr>
           <td width="55%" style="background-color:#FFFFFF; padding:14px 18px; font-family:Arial,Helvetica,sans-serif; font-size:13px; color:#4466AA; font-weight:600;">Extended Last Date to Submit</td>
           <td style="background-color:#FFFFFF; padding:14px 18px; font-family:Arial,Helvetica,sans-serif; font-size:13px; color:%%DEEP_NAVY%%; font-weight:700;">{{{Feedback_Item__c.End_Date__c}}}</td>
          </tr>
         </tbody>
        </table>
        <p style="font-family:Arial,Helvetica,sans-serif; font-size:14px; line-height:1.8; color:#444455; margin:0 0 28px 0;">If you have not submitted your response yet, kindly complete the feedback on or before <strong>{{{Feedback_Item__c.End_Date__c}}}</strong>. The link will close after this date and no further submissions will be accepted. If you have already submitted your feedback, please ignore this email.</p>
        <table cellpadding="0" cellspacing="0" border="0" style="margin-bottom:28px;">
         <tbody>
          <tr>
           <td align="center" style="background:linear-gradient(135deg,%%GRADIENT_START%% 0%,%%GRADIENT_END%% 100%); border-radius:8px;"><a href="%%PORTAL_LOGIN_URL%%" style="display:inline-block; padding:12px 36px; font-family:Arial,Helvetica,sans-serif; font-size:15px; font-weight:bold; color:#FFFFFF; text-decoration:none;">Complete Feedback →</a></td>
          </tr>
         </tbody>
        </table>
        <p style="font-family:Arial,Helvetica,sans-serif; font-size:14px; line-height:1.8; color:#444455; margin:0 0 28px 0;">We look forward to your cooperation and thank you for taking the time to share your valuable thoughts.</p>
        <p style="font-family:Arial,Helvetica,sans-serif; font-size:14px; line-height:1.8; color:#444455; margin:0;">Best regards,
         <br />
         <em>Program Office Team</em></p>
       </td>
      </tr>
      <!-- ── FOOTER ── -->
      <tr>
       <td style="background-color:%%DEEP_NAVY%%; border-radius:0 0 16px 16px; padding:28px 36px; text-align:center;">
        <p style="font-family:Arial,Helvetica,sans-serif; font-size:12px; color:%%MUTED_BLUE%%; margin:0 0 4px 0;">Automated Notification</p>
        <p style="font-family:Georgia,'Times New Roman',serif; font-size:16px; color:#FFFFFF; margin:0 0 2px 0;">Program Office</p>
        <p style="font-family:Arial,Helvetica,sans-serif; font-size:11px; color:#7AAACE; margin:0;">%%ORG_FOOTER_NAME%%</p>
        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:16px 0;">
         <tbody>
          <tr>
           <td>
            <div style="width:48px; height:2px; background:%%ACCENT_LINE%%; margin:0 auto; font-size:0; line-height:0;">&#xa0;</div>
           </td>
          </tr>
         </tbody>
        </table>
        <p style="font-family:Arial,Helvetica,sans-serif; font-size:10px; color:#5A7A9A; line-height:1.6; margin:0;">This is an automated message. Please do not reply directly to this email.
         <br />
         © %%ORG_FOOTER_NAME%%. All rights reserved.</p>
       </td>
      </tr>
     </tbody>
    </table>
   </td>
  </tr>
 </tbody>
</table>